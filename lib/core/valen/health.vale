// The health core (../health.js) in Valen. ./build.sh compiles it to Wasm, and ../healthWasm.js
// loads it as a drop-in for health.js.
//
// The bot's state stays in JS, so each event passes in the fields the core decides on, and the
// core reports what to do through these externs, which healthWasm.js provides.

extern func clientLoaded();
extern func requestRespawn();
extern func emitHealth();
extern func emitDeath();
extern func emitSpawn();
extern func emitRespawn();
extern func setState(isAlive bool, receivedHealth bool);

struct Health {
  autoRespawn bool;
  isAlive bool;
  receivedHealth bool;
}

func onHealthUpdate(self &Health mut, health float) {
  alive = health > 0.0;

  // The first health update spawns the bot, if it is alive
  if not self.receivedHealth {
    set self.receivedHealth = true;
    if alive {
      spawn();
    }
  }

  emitHealth();
  if not alive {
    if self.isAlive {
      set self.isAlive = false;
      emitDeath();
    }
    if self.autoRespawn {
      self.respawn();
    }
  } else if not self.isAlive {
    set self.isAlive = true;
    spawn();
  }
}

func onRespawned(self &Health mut) {
  set self.isAlive = false;
  emitRespawn();
}

func respawn(self &Health) {
  if not self.isAlive {
    requestRespawn();
  }
}

func spawn() {
  clientLoaded();
  emitSpawn();
}

func report(self &Health) {
  setState(self.isAlive, self.receivedHealth);
}

exported func healthUpdate(autoRespawn bool, isAlive bool, receivedHealth bool, health float) {
  core = Health(autoRespawn, isAlive, receivedHealth);
  core.onHealthUpdate(health);
  core.report();
}

exported func respawned(autoRespawn bool, isAlive bool, receivedHealth bool) {
  core = Health(autoRespawn, isAlive, receivedHealth);
  core.onRespawned();
  core.report();
}

exported func respawnCommand(autoRespawn bool, isAlive bool, receivedHealth bool) {
  core = Health(autoRespawn, isAlive, receivedHealth);
  core.respawn();
  core.report();
}

// valec only builds programs; healthWasm.js never calls this
exported func main() int {
  return 0;
}
